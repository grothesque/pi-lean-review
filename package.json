{
  "name": "@grothesque/pi-flex-review",
  "version": "0.0.0",
  "description": "Independent reviews in Pi with free-form requests and selectable context",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grothesque/pi-flex-review.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./review.ts",
      "default": "./review.ts"
    }
  },
  "types": "./review.ts",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./review.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
